---
const projects = [
  {
    num: '01',
    title: 'Wallds Barber',
    subtitle: 'Freelance · Sitio web profesional',
    description: 'Sitio web para barbería con diseño moderno, galería de servicios, sección de contacto y reservas. Desarrollado como proyecto freelance con enfoque en conversión y experiencia de usuario móvil.',
    tags: ['React', 'CSS', 'Responsive', 'UX'],
    url: 'https://walldsbarber.com/',
    accent: '#6366f1',
    featured: true,
  },
  {
    num: '02',
    title: 'Grillo Shop',
    subtitle: 'Freelance · E-commerce',
    description: 'Tienda en línea completa con catálogo de productos, carrito de compras y experiencia de compra fluida. Proyecto freelance desarrollado con foco en rendimiento, SEO y conversión.',
    tags: ['React', 'E-commerce', 'Python', 'API REST'],
    url: 'https://grillo-shop.com/',
    accent: '#34d399',
    featured: true,
  },

  {
    num: '03',
    title: 'SmartCampus — Anáhuac',
    subtitle: 'Suite universitaria · 7 sistemas',
    description: 'Suite de 7 sistemas web para gestión universitaria: admisiones, reportes académicos y administración institucional. Desarrollado y mantenido durante 5 años, sirviendo a estudiantes y personal de forma diaria.',
    tags: ['PHP', 'MySQL', 'JavaScript'],
    url: null,
    accent: '#6366f1',
    featured: false,
  },
];
---

<section id="proyectos">
  <div class="container">
    <p class="section-eyebrow reveal">Portafolio</p>
    <h2 class="section-title reveal reveal-delay-1">Proyectos <em>destacados</em></h2>

    <div class="projects-grid">
      {projects.map((p, i) => (
        <article
          class={`project-card ${p.featured ? 'featured' : ''} reveal`}
          style={`--delay: ${i * 0.1}s; --accent-local: ${p.accent}`}
        >
          <div class="card-top">
            <span class="proj-num">{p.num}</span>
            <div class="proj-links">
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener" class="proj-link" aria-label="Ver sitio">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                  ver sitio
                </a>
              )}
            </div>
          </div>

          <div class="card-body">
            <h3 class="proj-title">{p.title}</h3>
            <p class="proj-subtitle">{p.subtitle}</p>
            <p class="proj-desc">{p.description}</p>
          </div>

          <div class="card-footer">
            <div class="tag-list">
              {p.tags.map(t => <span class="tag">{t}</span>)}
            </div>
            {p.url && (
              <a href={p.url} target="_blank" rel="noopener" class="card-cta">
                Visitar <span class="cta-arrow">→</span>
              </a>
            )}
          </div>

          <div class="card-glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
#proyectos { background: var(--bg2); }

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}

/* 5th card spans full width */
.project-card:last-child:nth-child(odd) {
  grid-column: span 2;
}

.project-card {
  background: var(--bg2); padding: 2rem;
  display: flex; flex-direction: column; gap: 1rem;
  position: relative; overflow: hidden;
  transition: background 0.3s, transform 0.3s var(--ease-out-expo);
  transition-delay: var(--delay, 0s);
}
.project-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--accent-local), transparent);
  opacity: 0; transition: opacity 0.4s;
}
.project-card:hover { background: var(--bg3); }
.project-card:hover::before { opacity: 1; }

.card-glow {
  position: absolute; width: 200px; height: 200px;
  background: radial-gradient(circle, var(--accent-local), transparent 70%);
  opacity: 0; pointer-events: none; transition: opacity 0.4s;
  transform: translate(-50%, -50%);
  top: var(--gy, 50%); left: var(--gx, 50%);
  filter: blur(40px);
}
.project-card:hover .card-glow { opacity: 0.06; }

.card-top { display: flex; align-items: center; justify-content: space-between; }
.proj-num { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3); letter-spacing: 0.1em; }
.proj-links { display: flex; gap: 8px; }
.proj-link {
  display: flex; align-items: center; gap: 5px;
  font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3);
  text-decoration: none; padding: 4px 10px;
  border: 1px solid var(--border); border-radius: 4px;
  transition: color 0.2s, border-color 0.2s;
}
.proj-link:hover { color: var(--accent-local); border-color: var(--accent-local); }

.card-body { flex: 1; }
.proj-title {
  font-family: var(--font-display); font-size: 1.2rem; font-weight: 800;
  letter-spacing: -0.03em; color: var(--text); margin-bottom: 2px;
  transition: color 0.2s;
}
.project-card:hover .proj-title { color: var(--accent-local); }
.proj-subtitle { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent-local); letter-spacing: 0.04em; margin-bottom: 0.75rem; }
.proj-desc { font-size: 0.875rem; color: var(--text-2); line-height: 1.7; }

.card-footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
.tag-list { display: flex; flex-wrap: wrap; gap: 5px; }
.card-cta {
  font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-local);
  text-decoration: none; white-space: nowrap;
  display: flex; align-items: center; gap: 4px;
  transition: gap 0.25s var(--ease-spring);
}
.card-cta:hover { gap: 8px; }

@media (max-width: 768px) {
  .projects-grid { grid-template-columns: 1fr; }
  .project-card:last-child:nth-child(odd) { grid-column: span 1; }
}
</style>

<script>
document.querySelectorAll<HTMLElement>('.project-card').forEach(card => {
  card.addEventListener('mousemove', (e: MouseEvent) => {
    const rect = card.getBoundingClientRect();
    card.style.setProperty('--gx', ((e.clientX - rect.left) / rect.width * 100) + '%');
    card.style.setProperty('--gy', ((e.clientY - rect.top) / rect.height * 100) + '%');
  });
});
</script>
