---
// Hero.astro — animated hero with photo + floating tech badges
---

<section id="hero">
  <!-- Animated background grid -->
  <div class="hero-grid" aria-hidden="true">
    <div class="grid-lines"></div>
    <div class="glow-orb glow-1"></div>
    <div class="glow-orb glow-2"></div>
    <div class="glow-orb glow-3"></div>
  </div>

  <div class="container hero-inner">
    <!-- Left: text -->
    <div class="hero-text">
      <div class="hero-eyebrow">
        <span class="mono-tag">01</span>
        <span>Ing. en Software · Consultor & Arquitecto de Soluciones · Querétaro 🇲🇽</span>
      </div>

      <h1 class="hero-headline">
        <span class="line line-1">Transformo ideas</span>
        <span class="line line-2">en software que</span>
        <span class="line line-3"><em class="stroke-text" id="typewriter"></em></span>
      </h1>

      <p class="hero-desc">
        <strong>+8 años de experiencia</strong> diseñando y construyendo soluciones de software para resolver problemas reales de negocio. Desarrollo <strong>sistemas web, aplicaciones móviles, automatizaciones, integraciones y soluciones con IA,</strong> desde la arquitectura hasta su puesta en producción. Actualmente soy <strong>Ingeniero MerchantOps en Openpay</strong>.
      </p>

      <div class="hero-actions">
        <a href="#contacto" class="btn btn-primary">Hablemos de tu proyecto <span class="arrow">→</span></a>
        <a href="#proyectos" class="btn btn-ghost">Ver proyectos</a>
      </div>

      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num" data-count="8">0</span><span class="stat-suffix">+</span>
          <span class="stat-label">años exp.</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num" data-count="20">0</span><span class="stat-suffix">+</span>
          <span class="stat-label">proyectos desarrollados</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num" data-count="45">0</span><span class="stat-suffix">%</span>
          <span class="stat-label">mejora rendimiento</span>
        </div>
      </div>
    </div>

    <!-- Right: photo + floating badges -->
    <div class="hero-visual">
      <div class="photo-container">
        <div class="photo-frame">
          <img
            src="/me.png"
            alt="Daniel Hernández Sánchez — Ingeniero en Software y Consultor de Soluciones"
            class="hero-photo"
            loading="eager"
            width="400"
            height="480"
          />
          <div class="photo-overlay"></div>
          <div class="corner corner-tl"></div>
          <div class="corner corner-tr"></div>
          <div class="corner corner-bl"></div>
          <div class="corner corner-br"></div>
        </div>

        <!-- Floating badges -->
        <div class="badge badge-openpay float-1">
          <span class="badge-dot dot-green"></span>
          <span>Openpay · MerchantOps</span>
        </div>

        <div class="badge badge-stack float-2">
          <span class="badge-icon">🤖</span>
          <div>
            <div class="badge-title">IA & Backend</div>
            <div class="badge-sub">Python · LLMs · AWS S3</div>
          </div>
        </div>

        <div class="badge badge-freelance float-3">
          <span class="badge-dot dot-amber"></span>
          <span>Consultor · disponible</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
    <span>scroll</span>
  </div>
</section>

<style>
#hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  padding: 0;
}

.hero-grid {
  position: absolute; inset: 0;
  pointer-events: none;
}
.grid-lines {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(99,102,241,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(99,102,241,0.04) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 100%);
}
.glow-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  animation: driftOrb 12s ease-in-out infinite alternate;
}
.glow-1 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(99,102,241,0.12) 0%, transparent 70%);
  right: 10%; top: 10%;
  animation-duration: 14s;
}
.glow-2 {
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(167,139,250,0.08) 0%, transparent 70%);
  left: 5%; bottom: 20%;
  animation-duration: 10s; animation-delay: -3s;
}
.glow-3 {
  width: 200px; height: 200px;
  background: radial-gradient(circle, rgba(52,211,153,0.07) 0%, transparent 70%);
  right: 35%; bottom: 30%;
  animation-duration: 16s; animation-delay: -7s;
}
@keyframes driftOrb {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(20px, -20px) scale(1.05); }
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 4rem;
  align-items: center;
  padding-top: 7rem;
  padding-bottom: 5rem;
}

.hero-eyebrow {
  display: flex; align-items: center; gap: 10px;
  font-family: var(--font-mono);
  font-size: 0.72rem; color: var(--text-2);
  letter-spacing: 0.06em;
  margin-bottom: 1.5rem;
  animation: fadeSlideUp 0.7s 0.1s var(--ease-out-expo) both;
  flex-wrap: wrap;
}
.mono-tag {
  font-size: 0.7rem; color: var(--accent);
  background: rgba(99,102,241,0.1);
  border: 1px solid rgba(99,102,241,0.2);
  border-radius: 4px;
  padding: 1px 7px;
  flex-shrink: 0;
}

.hero-headline {
  font-family: var(--font-display);
  font-size: clamp(3.2rem, 6vw, 5.5rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1.0;
  color: var(--text);
  margin-bottom: 1.75rem;
}
.hero-headline .line {
  display: block;
  overflow: hidden;
}
.hero-headline .line-1 { animation: lineReveal 0.8s 0.2s var(--ease-out-expo) both; }
.hero-headline .line-2 { animation: lineReveal 0.8s 0.35s var(--ease-out-expo) both; }
.hero-headline .line-3 { animation: lineReveal 0.8s 0.5s var(--ease-out-expo) both; }

.stroke-text {
  font-style: normal;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  min-width: 2ch;
  display: inline-block;
}

@keyframes lineReveal {
  from { opacity:0; transform: translateY(100%); }
  to   { opacity:1; transform: translateY(0); }
}
@keyframes fadeSlideUp {
  from { opacity:0; transform: translateY(20px); }
  to   { opacity:1; transform: translateY(0); }
}

.hero-desc {
  font-size: 1.05rem; color: var(--text-2);
  line-height: 1.75; max-width: 500px;
  margin-bottom: 2.5rem;
  animation: fadeSlideUp 0.7s 0.6s var(--ease-out-expo) both;
}
.hero-desc strong { color: var(--text); font-weight: 500; }

.hero-actions {
  display: flex; gap: 1rem; flex-wrap: wrap;
  margin-bottom: 3rem;
  animation: fadeSlideUp 0.7s 0.75s var(--ease-out-expo) both;
}
.arrow { display: inline-block; transition: transform 0.25s var(--ease-spring); }
.btn-primary:hover .arrow { transform: translateX(4px); }

.hero-stats {
  display: flex; align-items: center; gap: 1.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border);
  animation: fadeSlideUp 0.7s 0.9s var(--ease-out-expo) both;
}
.stat { text-align: center; }
.stat-num {
  font-family: var(--font-display);
  font-size: 1.9rem; font-weight: 900;
  letter-spacing: -0.05em;
  color: var(--text); line-height: 1;
}
.stat-suffix {
  font-family: var(--font-display);
  font-size: 1.2rem; font-weight: 700;
  color: var(--accent);
}
.stat-label {
  display: block;
  font-size: 0.72rem; color: var(--text-3);
  font-family: var(--font-mono);
  letter-spacing: 0.06em;
  margin-top: 3px;
}
.stat-divider {
  width: 1px; height: 36px;
  background: var(--border); flex-shrink: 0;
}

.hero-visual {
  position: relative;
  animation: fadeSlideUp 0.9s 0.4s var(--ease-out-expo) both;
}
.photo-container { position: relative; width: 380px; }
.photo-frame {
  position: relative;
  border-radius: 16px; overflow: hidden;
  border: 1px solid var(--border-2);
  box-shadow: 0 0 60px rgba(99,102,241,0.15), 0 40px 80px rgba(0,0,0,0.5);
  background: var(--bg3);
}
.hero-photo {
  display: block; width: 100%; height: 460px;
  object-fit: cover; object-position: top center;
  transition: transform 0.6s var(--ease-out-expo);
}
.photo-frame:hover .hero-photo { transform: scale(1.03); }
.photo-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 50%, rgba(8,8,16,0.7) 100%);
  pointer-events: none;
}

.corner {
  position: absolute; width: 16px; height: 16px; pointer-events: none;
}
.corner-tl { top: -1px; left: -1px; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); border-radius: 4px 0 0 0; }
.corner-tr { top: -1px; right: -1px; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); border-radius: 0 4px 0 0; }
.corner-bl { bottom: -1px; left: -1px; border-bottom: 2px solid var(--accent); border-left: 2px solid var(--accent); border-radius: 0 0 0 4px; }
.corner-br { bottom: -1px; right: -1px; border-bottom: 2px solid var(--accent); border-right: 2px solid var(--accent); border-radius: 0 0 4px 0; }

.badge {
  position: absolute;
  display: flex; align-items: center; gap: 8px;
  background: rgba(15,15,26,0.9);
  border: 1px solid var(--border-2);
  border-radius: 10px; padding: 10px 14px;
  font-size: 0.78rem; font-weight: 500; color: var(--text);
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  white-space: nowrap;
}
.badge-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.dot-green { background: var(--accent-3); box-shadow: 0 0 8px var(--accent-3); animation: blink 2s infinite; }
.dot-amber { background: var(--accent-4); box-shadow: 0 0 8px var(--accent-4); animation: blink 2.5s infinite 0.5s; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.4} }
.badge-icon { font-size: 1rem; }
.badge-title { font-size: 0.75rem; font-weight: 500; color: var(--text); line-height: 1.2; }
.badge-sub { font-size: 0.68rem; color: var(--text-2); font-family: var(--font-mono); }

.badge-openpay  { top: 24px; right: -20px; }
.badge-stack    { bottom: 80px; left: -24px; }
.badge-freelance{ bottom: 28px; right: -16px; }

.float-1 { animation: float 5s ease-in-out infinite; }
.float-2 { animation: float 6s ease-in-out infinite 1s; }
.float-3 { animation: float 4.5s ease-in-out infinite 2s; }
@keyframes float {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-8px); }
}

.scroll-indicator {
  position: absolute; bottom: 2.5rem; left: 50%;
  transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  opacity: 0.35;
  animation: fadeSlideUp 1s 1.2s var(--ease-out-expo) both;
}
.scroll-line {
  width: 1px; height: 48px;
  background: linear-gradient(to bottom, transparent, var(--accent));
  animation: scrollPulse 2s ease-in-out infinite;
}
.scroll-indicator span {
  font-family: var(--font-mono); font-size: 0.65rem;
  letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-2);
}
@keyframes scrollPulse {
  0%,100% { opacity:0.35; } 50% { opacity:0.7; }
}

@media (max-width: 900px) {
  .hero-inner { grid-template-columns: 1fr; padding-top: 8rem; text-align: center; }
  .hero-text { order: 2; } .hero-visual { order: 1; }
  .hero-eyebrow { justify-content: center; }
  .hero-desc { margin-left: auto; margin-right: auto; }
  .hero-actions { justify-content: center; }
  .hero-stats { justify-content: center; }
  .photo-container { width: 280px; margin: 0 auto; }
  .hero-photo { height: 340px; }
  .badge-openpay { right: -10px; } .badge-stack { left: -10px; } .badge-freelance { right: -10px; }
}
@media (max-width: 480px) { .badge-stack { display: none; } .hero-stats { gap: 1rem; } }
</style>

<script>
const words = ['funciona.', 'escala.', 'evoluciona.', 'perdura.'];
let wi = 0, ci = 0, deleting = false;
const el = document.getElementById('typewriter')!;
function tick() {
  const word = words[wi];
  if (!deleting) {
    ci++;
    el.textContent = word.slice(0, ci);
    if (ci === word.length) { deleting = true; setTimeout(tick, 2200); return; }
  } else {
    ci--;
    el.textContent = word.slice(0, ci);
    if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; }
  }
  setTimeout(tick, deleting ? 60 : 110);
}
setTimeout(tick, 1200);

const counters = document.querySelectorAll<HTMLElement>('.stat-num[data-count]');
const cObs = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    const el = entry.target as HTMLElement;
    const target = parseInt(el.dataset.count!);
    let start = 0; const step = target / 40;
    const int = setInterval(() => {
      start = Math.min(start + step, target);
      el.textContent = Math.floor(start).toString();
      if (start >= target) clearInterval(int);
    }, 30);
    cObs.unobserve(el);
  });
}, { threshold: 0.5 });
counters.forEach(c => cObs.observe(c));
</script>
